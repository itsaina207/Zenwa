# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
ZENWA_TELEGRAM=${TELEGRAM_BOT_TOKEN}

# Hedera Network Configuration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=${HEDERA_AI_KIT_ACCOUNT_ID}
HEDERA_OPERATOR_KEY=${HEDERA_AI_KIT_PRIVATE_KEY}

# Hedera AI Kit Account Configuration
HEDERA_AI_KIT_ACCOUNT_ID=${HEDERA_AI_KIT_ACCOUNT_ID}
HEDERA_AI_KIT_PRIVATE_KEY=${HEDERA_AI_KIT_PRIVATE_KEY}
HEDERA_AI_KIT_PUBLIC_KEY=${HEDERA_AI_KIT_PUBLIC_KEY}
HEDERA_AI_KIT_EVM_ADDRESS=${HEDERA_AI_KIT_EVM_ADDRESS}

# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}

# Server Configuration
PORT=8000
NODE_ENV=production

# Database Configuration
DATABASE_URL=${DATABASE_URL}
PGHOST=${PGHOST}
PGPORT=${PGPORT}
PGUSER=${PGUSER}
PGPASSWORD=${PGPASSWORD}
PGDATABASE=${PGDATABASE}

# Mirror Node API (Optional - default is testnet)
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
