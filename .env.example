# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ZENWA_TELEGRAM=your_telegram_bot_token

# Hedera Network Configuration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=your_private_key_here

# Hedera AI Kit Account Configuration
HEDERA_AI_KIT_ACCOUNT_ID=0.0.xxxxx
HEDERA_AI_KIT_PRIVATE_KEY=your_private_key_here
HEDERA_AI_KIT_PUBLIC_KEY=your_public_key_here
HEDERA_AI_KIT_EVM_ADDRESS=your_evm_address_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Server Configuration
PORT=8000
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgres://user:password@host:port/database
PGHOST=your_database_host
PGPORT=your_database_port
PGUSER=your_database_user
PGPASSWORD=your_database_password
PGDATABASE=your_database_name

# Mirror Node API (Optional - default is testnet)
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
