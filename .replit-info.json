{
  "app": "zenwa",
  "description": "Zenwa Telegram Bot for Hedera",
  "language": "nodejs",
  "port": 8000,
  "tgbot_port": 8000,
  "engine": "node",
  "version": "1.0.0",
  "alwaysOn": true,
  "enableCronJob": true,
  "startCommand": "node replit-deploy.js",
  "env": {
    "NODE_ENV": "production",
    "REPLIT_DEPLOYMENT": "true"
  },
  "web": {
    "start": "node replit-deploy.js"
  },
  "deployment": {
    "startCommand": "node replit-deploy.js",
    "alwaysOn": true,
    "deploymentTarget": "cloud"
  }
}