{
  "app": "zenwa",
  "description": "Zenwa Telegram Bot for Hedera",
  "language": "nodejs",
  "port": 5000,
  "tgbot_port": 8000,
  "engine": "node",
  "version": "1.0.0",
  "alwaysOn": true,
  "env": {
    "NODE_ENV": "production"
  },
  "web": {
    "start": "node replit.js"
  },
  "deployment": {
    "startCommand": "node replit.js",
    "alwaysOn": true
  }
}