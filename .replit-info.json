{
  "app": "zenwa",
  "description": "Zenwa Telegram Bot for Hedera",
  "language": "nodejs",
  "port": 8000,
  "tgbot_port": 8000,
  "engine": "node",
  "version": "1.0.0",
  "alwaysOn": true,
  "enableCronJob": true,
  "startCommand": "bash deploy.sh",
  "env": {
    "NODE_ENV": "production",
    "REPLIT_DEPLOYMENT": "true"
  },
  "web": {
    "start": "bash deploy.sh"
  },
  "deployment": {
    "startCommand": "bash deploy.sh",
    "alwaysOn": true,
    "deploymentTarget": "cloud"
  }
}